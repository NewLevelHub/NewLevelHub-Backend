# Django
SECRET_KEY=change-me-staging-secret-key
DEBUG=True
ALLOWED_HOSTS=46.247.42.97,staging.newlevelhub.kz

# Database (POSTGRES_HOST=db — имя сервиса в docker-compose)
POSTGRES_DB=newlevelhub_staging
POSTGRES_USER=nlh_user
POSTGRES_PASSWORD=change-me-staging-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (адреса фронтенда на staging)
CORS_ALLOWED_ORIGINS=http://46.247.42.97:3000,http://staging.newlevelhub.kz

# Security — отключить SSL-редирект если нет HTTPS
SECURE_SSL_REDIRECT=False

# Email (console на staging — письма в логи контейнера)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@newlevelhub.kz

# Frontend URL
FRONTEND_URL=http://staging.newlevelhub.kz
# Public API origin for QR images in guest-pass emails (Gmail loads https://.../api/...)
BACKEND_URL=https://staging.newlevelhub.kz

# Upload limits
UPLOAD_MAX_SIZE_MB=100

# TEST: verify manual env update flow (add this to .env.staging on server)
TEST_MANUAL_ENV_VAR=hello-from-server
