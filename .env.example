# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=newlevelhub_db
POSTGRES_USER=nlh_user
POSTGRES_PASSWORD=nlh_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@newlevelhub.kz
REMINDER_MINUTES_BEFORE=15
NO_SHOW_MINUTES=15

# Frontend URL (for email links, QR redirects, etc.)
FRONTEND_URL=http://localhost:3000
# Public API URL for email images/links (set to API host on staging/prod, e.g. https://api.staging.newlevelhub.kz)
BACKEND_URL=

# Upload limits
UPLOAD_MAX_SIZE_MB=100

# --- S3 / MinIO (optional; when USE_S3 or AWS_STORAGE_BUCKET_NAME is set, files go to object storage) ---
# USE_S3=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_PRESIGNED_URL_EXPIRY=900
# Docker local MinIO (see docker-compose.local.yml): bucket newlevelhub-local, user/password minioadmin
# DevOps: bucket must be private; CORS GET only from frontend origins; IAM: PutObject, GetObject, DeleteObject, HeadObject, ListBucket on this bucket.
# Optional error reporting for Celery storage cleanup failures:
# SENTRY_DSN=
